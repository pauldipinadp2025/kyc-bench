# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Shared secret required in the X-Admin-Key header to upload a new policy.
# Pick your own long random string.
ADMIN_KEY=change-me-to-a-long-random-string
# Comma-separated list of origins allowed to call this API from a browser.
# Set this to your GitHub Pages URL once deployed, e.g.:
# ALLOWED_ORIGINS=https://dipina1502innovator.github.io
ALLOWED_ORIGINS=*
